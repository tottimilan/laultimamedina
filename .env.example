# ==============================================
# VARIABLES DE ENTORNO - LA ÚLTIMA MEDINA
# ==============================================
# Copia este archivo a .env.local y configura tus valores
# NUNCA commits archivos .env con claves reales

# ----------------------------------------------
# FRONTEND
# ----------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# ----------------------------------------------
# STRAPI CMS
# ----------------------------------------------
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=tu_token_de_strapi_aqui
STRAPI_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ----------------------------------------------
# NEXTAUTH (Autenticación)
# ----------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu_clave_secreta_de_32_caracteres

# ----------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ----------------------------------------------
# Local:
DATABASE_URL=postgresql://user:password@localhost:5432/laultimamedina

# Railway (producción):
# DATABASE_URL=postgresql://...

# Vercel Postgres (alternativa):
# DATABASE_URL=postgres://...

# ----------------------------------------------
# STRIPE (Pagos y Membresías)
# ----------------------------------------------
# Obtén tus claves en: https://dashboard.stripe.com/apikeys

# Modo TEST (desarrollo)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_aqui
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_aqui

# Modo LIVE (producción)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_aqui
# STRIPE_SECRET_KEY=sk_live_tu_clave_secreta_aqui

# Webhook Secret (diferente para test y live)
# Obtén en: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# ----------------------------------------------
# EMAIL (Opcional - para notificaciones)
# ----------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASSWORD=tu_app_password_aqui
# SMTP_FROM=noreply@laultimamedina.com

# ----------------------------------------------
# ANALYTICS (Opcional)
# ----------------------------------------------
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ----------------------------------------------
# CLOUDFLARE R2 (Opcional - para media storage)
# ----------------------------------------------
# R2_ACCOUNT_ID=tu_account_id
# R2_ACCESS_KEY_ID=tu_access_key
# R2_SECRET_ACCESS_KEY=tu_secret_key
# R2_BUCKET_NAME=laultimamedina-media
# R2_PUBLIC_URL=https://media.laultimamedina.com

# ----------------------------------------------
# OTROS
# ----------------------------------------------
# NODE_ENV=development
# ANALYZE=false
